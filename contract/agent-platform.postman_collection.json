    {
      "name": "Agents",
      "description": "Create and manage agent nodes. Called by the sweepstakes backend on the operator admin's behalf.",
      "item": [
        {
          "name": "Create top-level agent (Manager)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{createKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{managerUsername}}\",\n  \"name\": \"Manager One\",\n  \"tempPassword\": \"Temp123!\",\n  \"creditLimit\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{operatorId}}/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{operatorId}}",
                "agents"
              ]
            },
            "description": "Creates an agent under the operator. **Omit** `parentAgentId` for a top-level agent (child of the operator admin); include it to create deeper in the tree.\n\n**Body**\n- `username` (required) — unique per operator\n- `tempPassword` (required) — forced change on first login\n- `name`, `canCreateAgents` (default true)\n- `creditLimit` — only honored for a top-level agent; sets the operator-wide limit\n\n**Headers**: `Idempotency-Key` (required). Re-sending the same key returns the same agent.\n\n**201** returns `{ id, operatorId, parentAgentId, username, name, canCreateAgents }`. The test saves `id` into `{{agentId}}`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('has id', () => pm.expect(json.id).to.be.a('string'));",
                  "pm.collectionVariables.set('agentId', json.id);",
                  "console.log('agentId =', json.id);"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Idempotency-Key",
                    "value": "k-mgr1"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"mgr1\",\n  \"name\": \"Manager One\",\n  \"tempPassword\": \"Temp123!\",\n  \"creditLimit\": 1000\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/v1/tenants/{{operatorId}}/agents",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v1",
                    "tenants",
                    "{{operatorId}}",
                    "agents"
                  ]
                }
              },
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"50ea5899-9ef2-4edc-a1fe-dadbeacde1f1\",\n  \"operatorId\": \"demo-operator\",\n  \"parentAgentId\": null,\n  \"username\": \"mgr1\",\n  \"name\": \"Manager One\",\n  \"canCreateAgents\": true\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
        {
          "name": "Create sub-agent (under {{agentId}})",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "k-sub1"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parentAgentId\": \"{{agentId}}\",\n  \"username\": \"sub1\",\n  \"name\": \"Super Agent\",\n  \"tempPassword\": \"Temp123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{operatorId}}/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{operatorId}}",
                "agents"
              ]
            },
            "description": "Creates an agent **below** an existing one by passing `parentAgentId`. Uses the `{{agentId}}` captured by the Create top-level agent request. Nesting is unlimited."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('parent is the manager', () => pm.expect(pm.response.json().parentAgentId).to.eql(pm.collectionVariables.get('agentId')));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List agents (tree)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{operatorId}}/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{operatorId}}",
                "agents"
              ]
            },
            "description": "Returns the whole agent tree for the operator, parents before children, each with its live `balance`, `status`, `path` and derived `level` (1=Manager, 2=Super Agent, 3=Agent, 4+=Sub-agent). This is the read model the console table renders.\n\n**200** → `AgentListItem[]`. Signed like every call; no body, so the signature is over an empty body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const arr = pm.response.json();",
                  "pm.test('is an array', () => pm.expect(arr).to.be.an('array'));",
                  "console.log('agents in tree =', arr.length);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update agent (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed Manager\",\n  \"canCreateAgents\": true,\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{operatorId}}/agents/{{agentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{operatorId}}",
                "agents",
                "{{agentId}}"
              ]
            },
            "description": "Partially updates an agent. All fields optional:\n- `name` — display name\n- `canCreateAgents` — allow/deny creating sub-agents\n- `status` — `active` or `blocked`\n\nUses `{{agentId}}` captured by **Create top-level agent**. **200** returns the updated `AgentListItem`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('name updated', () => pm.expect(pm.response.json().name).to.eql('Renamed Manager'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete agent (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{operatorId}}/agents/{{agentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{operatorId}}",
                "agents",
                "{{agentId}}"
              ]
            },
            "description": "Deletes an agent. Refused when it would orphan a subtree or lose credit:\n- **409 HAS_DESCENDANTS** — the agent still has sub-agents\n- **422 NONZERO_BALANCE** — withdraw its credit first\n\nLedger history is retained. Targets `{{agentId}}`; the test accepts 200 (deleted) or 409 (has sub-agents) so a full-folder run stays green."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 deleted or 409 has sub-agents', () => pm.expect([200, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.test('deleted flag', () => pm.expect(pm.response.json().deleted).to.eql(true));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
