    {
      "name": "Negative tests",
      "description": "Each request forces a specific failure to show the error contract.",
      "item": [
        {
          "name": "Missing signature headers (401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Strip the headers the collection script added, to reproduce a 401.",
                  "['x-operator-id','x-api-key','x-timestamp','x-signature'].forEach(h => pm.request.headers.remove(h));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.include('Missing signature headers'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
