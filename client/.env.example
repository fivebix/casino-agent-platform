# Backend base URL (sweepstakes-backend). The browser calls same-origin /api/*,
# next.config.ts rewrites it to ${NEXT_PUBLIC_API_URL}/api/* so the agent cookies stay first-party.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Operator subdomain used when the panel is opened on localhost / 127.0.0.1 (no subdomain in the host).
# On <subdomain>.localhost:3005 or a real <subdomain>.<domain> host the subdomain wins.
NEXT_PUBLIC_DEFAULT_SUBDOMAIN=demo

# Optional links in the top bar / nav. Unset = the item is still shown but goes nowhere.
NEXT_PUBLIC_ODRYN_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=
