# The agent-platform server (NOT exposed to the browser).
AGENT_API_URL=http://localhost:4100

# Operator credentials — must match what `npm run seed` created on the server.
# These stay server-side; requests are signed in the Next.js route handler.
AGENT_OPERATOR_ID=demo-operator
AGENT_API_KEY=demo-api-key
AGENT_SIGNING_SECRET=demo-signing-secret
NEXT_PUBLIC_OPERATOR_ID=demo-operator
